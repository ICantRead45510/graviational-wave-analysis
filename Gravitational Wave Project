      "source": [
        "#Imports necessary libraries\n",
        "import matplotlib.pyplot as plt\n",
        "import lal\n",
        "lal.swig_redirect_standard_output_error(False)\n",
        "from gwpy.timeseries import TimeSeries\n",
        "from pycbc.waveform import get_td_waveform\n",
        "from gwosc.datasets import event_gps\n",
        "from gwosc.datasets import find_datasets\n",
        "from gwosc import datasets\n",
        "#Finds exact name of most recent dataset of GW150914\n",
        "event_name = (datasets.find_datasets(match =\"GW150914\", type = \"events\")[-1])\n",
        "event_time = event_gps(event_name)\n",
        "timerange = (int(event_time)-16, int(event_time)+16)\n",
        "h1data = TimeSeries.fetch_open_data('H1', timerange[0], timerange[1], cache=False)\n",
        "h1data = h1data.bandpass(50,500).notch(60).crop(event_time -2, event_time+2)\n",
        "h1data = h1data.q_transform(qrange = (5, 50), frange = (50,500))\n",
        "l1data = TimeSeries.fetch_open_data('L1', timerange[0], timerange[1], cache=False)\n",
        "l1data = l1data.bandpass(50,500).notch(60).crop(event_time -2, event_time+2)\n",
        "l1data = l1data.q_transform(qrange = (5, 50), frange = (50,500))\n",
        "plot = h1data.plot()\n",
        "plot2 = l1data.plot()\n",
        "ax = plot.gca()\n",
        "ax.set_yscale(\"log\")\n",
        "ax.set_xlabel(\"Time (seconds)\")\n",
        "ax.set_ylabel(\"Frequency (Hertz)\")\n",
        "ax.set_title(\"Q transform plot of GW150914 (LIGO Hanford)\")\n",
        "ax2 = plot2.gca()\n",
        "ax2.set_yscale(\"log\")\n",
        "ax2.set_xlabel(\"Time (seconds)\")\n",
        "ax2.set_ylabel(\"Frequency (Hertz)\")\n",
        "ax2.set_title(\"Q transform plot of GW150914 (LIGO Livingston)\")\n",
        "plot.show()\n",
        "plot2.show()"
      ]
    }
